# Docker Compose and TripWeave.services.stack load this file after copying it to .env.
# Existing process environment variables take precedence over .env.
# Set your own random private password (at least 12 characters); do not commit .env.
TRIPWEAVE_ACCESS_PASSWORD=
TRIPWEAVE_MODEL_MODE=rules
TRIPWEAVE_API_KEY=
TRIPWEAVE_MODEL=
TRIPWEAVE_BASE_URL=
TRIPWEAVE_WEATHER_PROVIDER=sample
