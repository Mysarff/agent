# Docker Compose and SmartVoyage.services.stack load this file after copying it to .env.
# Existing process environment variables take precedence over .env.
# Set your own random private password (at least 12 characters); do not commit .env.
SMARTVOYAGE_ACCESS_PASSWORD=
SMARTVOYAGE_MODEL_MODE=rules
SMARTVOYAGE_API_KEY=
SMARTVOYAGE_MODEL=
SMARTVOYAGE_BASE_URL=
SMARTVOYAGE_WEATHER_PROVIDER=sample
